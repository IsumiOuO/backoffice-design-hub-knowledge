# 從 Telegram 的 @BotFather 取得。請勿提交真實 Token。
TELEGRAM_BOT_TOKEN=

# 第一次啟動先保留空白，並將 SETUP_MODE 設為 true。
# 對 Bot 傳送 /whoami 後，把回傳的數字填在這裡；多人用逗號分隔。
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SETUP_MODE=true

# 規格文件的 GitHub 瀏覽網址。通常不需要修改。
KNOWLEDGE_GITHUB_BASE_URL=https://github.com/IsumiOuO/backoffice-design-hub-knowledge/blob/main

# 本機測試紀錄。false 可完全關閉；紀錄檔不會上傳 GitHub。
BOT_QUERY_LOG_ENABLED=true
BOT_QUERY_LOG_PATH=bot/logs/query-log.jsonl
